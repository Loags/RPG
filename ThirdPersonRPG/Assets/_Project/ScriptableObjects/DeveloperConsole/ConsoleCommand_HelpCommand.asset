  m_Script: {fileID: 11500000, guid: b9d6eaa86281d0247a5f889f757f0ce2, type: 3}
  m_Name: ConsoleCommand_HelpCommand
  m_EditorClassIdentifier: 
  commandWord: help
  possibleCommands: []
  helpText: '<b>Navigation:</b> You can navigate through the preview option with
    arrowKeyUp and arrowKeyDown

    <b>Selection:</b> You can press TAB to auto
    complete the selected preview

    <b>Execute command:</b> You can press RETURN
    to execute a command


    <b>Input format:</b> Always start the command with
    ''/''. After that enter the type of the command ''/typeOfCommand''. After that
    make a space and enter one of the possible commands ''/typeOfCommand command''.
    If there is a specific suffix you have to enter, make a space and put in the
    value ''/typeOfCommand command value''.


    <b>Console History:</b> The history
    displays the previously executed commands, to keep track

    <b>Console Debug
    History:</b> The history displays the actions the previously executed commands
    have dont automatically in the background'
